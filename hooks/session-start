#!/bin/bash
# SessionStart hook for karpathy-wiki.
#
# The hook has two intentionally small responsibilities:
#   1. inject the loader rules into an interactive parent session;
#   2. in session_start mode, launch one non-blocking dispatcher tick.
#
# Source scanning, queue claims, concurrency, retries, heartbeat, and provider
# execution are owned by the dispatcher. Scheduled mode is deliberately quiet
# here because its LaunchAgent owns activation.

set -uo pipefail

# Provider workers and nested agents must not load rules or start another tick.
if [[ -n "${WIKI_CAPTURE:-}" || -n "${CLAUDE_AGENT_PARENT:-}" ]]; then
  exit 0
fi

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${HOOK_DIR}/.." && pwd)"
# shellcheck source=/dev/null
source "${REPO_ROOT}/scripts/wiki-lib.sh"

# Loader injection always runs, whether or not this cwd has a wiki.
LOADER_PATH="${REPO_ROOT}/skills/using-karpathy-wiki/SKILL.md"
if [[ -f "${LOADER_PATH}" ]]; then
  loader_content="$(cat "${LOADER_PATH}")"

  escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
  }

  loader_escaped="$(escape_for_json "${loader_content}")"
  wiki_cli_escaped="$(escape_for_json "${REPO_ROOT}/bin/wiki")"
  context_prefix="<EXTREMELY_IMPORTANT>\nYou have karpathy-wiki rules.\n\n**Runtime CLI for this session:** execute \`${wiki_cli_escaped}\` whenever a wiki skill refers to \`bin/wiki\` or \`wiki\`. This path belongs to the installed plugin; do not rely on a global symlink or PATH entry.\n\n**Below is the full content of the using-karpathy-wiki loader skill, auto-loaded into every conversation. For all other karpathy-wiki skills (capture, read, ingest), use the Skill tool when their moment arrives:**\n\n"
  context_suffix='\n</EXTREMELY_IMPORTANT>'
  session_context="${context_prefix}${loader_escaped}${context_suffix}"

  if [[ -n "${CURSOR_PLUGIN_ROOT:-}" ]]; then
    printf '{"additional_context":"%s"}' "${session_context}"
  elif [[ -n "${CLAUDE_PLUGIN_ROOT:-}" && -z "${COPILOT_CLI:-}" ]]; then
    printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}' "${session_context}"
  else
    printf '{"additionalContext":"%s"}' "${session_context}"
  fi
fi

wiki="$(wiki_root_from_cwd 2>/dev/null || echo "")"
[[ -n "${wiki}" ]] || exit 0

config_json="$(python3 "${REPO_ROOT}/scripts/wiki_config.py" show --wiki "${wiki}" 2>&1)"
config_exit=$?
if [[ "${config_exit}" -ne 0 ]]; then
  printf 'karpathy-wiki: dispatcher not started: %s\n' \
    "${config_json//$'\n'/ | }" >&2
  exit 0
fi
export WIKI_INGEST_LOG="${WIKI_INGEST_LOG:-${wiki}/.ingest.log}"

dispatch_mode="$(printf '%s' "${config_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin)["ingest"]["dispatch_mode"])' 2>/dev/null || echo "")"
case "${dispatch_mode}" in
  scheduled)
    log_info "session-start: scheduled mode; activation owned by scheduler"
    ;;
  session_start)
    nohup python3 "${REPO_ROOT}/scripts/wiki_dispatch.py" tick \
      --wiki "${wiki}" --source session_start --scan \
      >> "${wiki}/.ingest.log" 2>&1 < /dev/null &
    disown 2>/dev/null || true
    ;;
  *)
    log_warn "session-start: dispatcher not started | invalid dispatch mode"
    ;;
esac
exit 0
