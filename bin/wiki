#!/bin/bash
# karpathy-wiki user CLI.
#
# Subcommands:
#   wiki status         — health report
#   wiki doctor         — deep lint (post-MVP placeholder)
#
# All other interactions are via natural language to the agent.

set -e

# Resolve symlinks so the script works when invoked via ~/.local/bin/wiki
# or any other symlink on PATH. Without this, REPO_ROOT resolves to the
# directory containing the symlink (e.g. ~/.local/bin), not the repo.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${SOURCE}" ]]; do
  TARGET="$(readlink "${SOURCE}")"
  if [[ "${TARGET}" == /* ]]; then
    SOURCE="${TARGET}"
  else
    SOURCE="$(cd "$(dirname "${SOURCE}")" && pwd)/${TARGET}"
  fi
done
SCRIPT_DIR="$(cd "$(dirname "${SOURCE}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
# shellcheck source=/dev/null
source "${REPO_ROOT}/scripts/wiki-lib.sh"

yaml_quote() {
  python3 -c 'import json, sys; print(json.dumps(sys.argv[1], ensure_ascii=False))' "$1"
}

sub="${1:-help}"
shift || true

wiki_root() {
  local w
  w="$(wiki_root_from_cwd 2>/dev/null || echo "")"
  [[ -n "${w}" ]] || { echo >&2 "no wiki found in cwd or parents"; exit 1; }
  echo "${w}"
}

case "${sub}" in
  status)
    bash "${REPO_ROOT}/scripts/wiki-status.sh" "$(wiki_root)"
    ;;
  doctor)
    echo "wiki doctor: not implemented in MVP. For now, ask the agent to run a deep lint of the wiki."
    exit 1
    ;;
  capture)
    # bin/wiki capture — single entry point for chat-driven captures.
    # Reads body from stdin OR --body-file, validates, runs resolver,
    # handles prompts/headless fallback, writes every capture, then requests
    # one bounded dispatcher tick per target wiki.

    title=""
    kind=""
    suggested_action="create"
    body_file=""
    evidence_path=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --title) title="$2"; shift 2 ;;
        --kind) kind="$2"; shift 2 ;;
        --suggested-action) suggested_action="$2"; shift 2 ;;
        --body-file) body_file="$2"; shift 2 ;;
        --evidence-path) evidence_path="$2"; shift 2 ;;
        *) echo >&2 "wiki capture: unknown arg: $1"; exit 1 ;;
      esac
    done
    [[ -n "${title}" ]] || { echo >&2 "wiki capture: --title required"; exit 1; }
    [[ -n "${kind}" ]] || { echo >&2 "wiki capture: --kind required (chat-only|chat-attached|raw-direct)"; exit 1; }
    case "${suggested_action}" in
      create|update|augment|auto) ;;
      *) echo >&2 "wiki capture: --suggested-action must be create, update, augment, or auto"; exit 1 ;;
    esac
    for scalar_name in title evidence_path; do
      scalar_value="${!scalar_name}"
      if [[ "${scalar_value}" == *$'\n'* || "${scalar_value}" == *$'\r'* ]]; then
        echo >&2 "wiki capture: --${scalar_name//_/-} must be a single line"
        exit 1
      fi
    done

    # Evidence-path validation. Iron rule (per skill): capture's `evidence`
    # field is the canonical source path, or the literal "conversation"
    # only when capture_kind=chat-only with no real path. The manifest
    # `origin` field reads this verbatim, so chat-attached and raw-direct
    # MUST carry a real path.
    case "${kind}" in
      chat-only)
        if [[ -n "${evidence_path}" ]]; then
          echo >&2 "wiki capture: --evidence-path is not valid for --kind chat-only"
          exit 1
        fi
        ;;
      chat-attached|raw-direct)
        if [[ -z "${evidence_path}" ]]; then
          echo >&2 "wiki capture: --evidence-path <abs> is required for --kind ${kind}"
          exit 1
        fi
        if [[ "${evidence_path}" != /* ]]; then
          echo >&2 "wiki capture: --evidence-path must be absolute, got: ${evidence_path}"
          exit 1
        fi
        ;;
    esac

    # Body input: --body-file OR stdin (must be a pipe/file, not TTY)
    body_buf="$(mktemp)"
    trap 'rm -f "${body_buf}"' EXIT
    if [[ -n "${body_file}" ]]; then
      [[ -f "${body_file}" ]] || { echo >&2 "wiki capture: body file missing: ${body_file}"; exit 1; }
      cp "${body_file}" "${body_buf}"
    elif [[ ! -t 0 ]]; then
      cat > "${body_buf}"
    else
      echo >&2 "wiki capture: no body provided. Pipe on stdin or use --body-file <path>."
      exit 1
    fi
    body_size=$(wc -c < "${body_buf}")
    if [[ "${body_size}" -gt 262144 ]]; then
      echo >&2 "wiki capture: body is ${body_size} bytes (max 256 KB). Use raw-direct ingest: mv <file> <wiki>/inbox/ && wiki ingest-now."
      exit 1
    fi
    if ! python3 - "${body_buf}" <<'PY'
from pathlib import Path
import sys

try:
    Path(sys.argv[1]).read_text(encoding="utf-8")
except UnicodeDecodeError:
    raise SystemExit(1)
PY
    then
      echo >&2 "wiki capture: body must be valid UTF-8"
      exit 1
    fi

    # Validate body against kind floor
    case "${kind}" in
      chat-only)      floor=1500 ;;
      chat-attached)  floor=1000 ;;
      raw-direct)     floor=0 ;;
      *) echo >&2 "wiki capture: unknown --kind '${kind}'"; exit 1 ;;
    esac
    if [[ "${body_size}" -lt "${floor}" ]]; then
      echo >&2 "wiki capture: body is ${body_size} bytes; floor for kind=${kind} is ${floor}. Expand the body."
      exit 1
    fi

    # Resolve one immutable routing snapshot. Every field used below comes
    # from this exact plan, so a concurrent mode change cannot split capture
    # target selection from promotion policy selection.
    resolver_plan="$(bash "${REPO_ROOT}/scripts/wiki-resolve.sh" --plan 2>/dev/null)" \
      && resolver_exit=0 || resolver_exit=$?
    resolver_out=""

    # Headless detection: any of WIKI_CAPTURE / CLAUDE_HEADLESS=1 / no TTY+no CLAUDE_AGENT_INTERACTIVE / CLAUDE_AGENT_PARENT.
    is_headless=0
    if [[ -n "${WIKI_CAPTURE:-}" || "${CLAUDE_HEADLESS:-0}" == "1" || -n "${CLAUDE_AGENT_PARENT:-}" ]]; then
      is_headless=1
    elif [[ ! -t 0 && -z "${CLAUDE_AGENT_INTERACTIVE:-}" ]]; then
      is_headless=1
    fi

    case "${resolver_exit}" in
      0)
        # Success — proceed with returned wikis
        ;;
      11)
        # Cwd unconfigured.
        if [[ "${is_headless}" == 1 ]]; then
          reason="headless: workspace routing is unconfigured; run wiki use project|main|both"
          orphan="$(bash "${REPO_ROOT}/scripts/wiki-orphan.sh" \
            --title "${title}" \
            --reason "${reason}" \
            --body-file "${body_buf}")"
          echo >&2 "wiki capture: aborted; body preserved at ${orphan}"
          echo >&2 "wiki capture: cwd unconfigured. Run one of:"
          echo >&2 "  wiki use project   # captures stay in this repo (./wiki/)"
          echo >&2 "  wiki use main      # captures go to the main wiki"
          echo >&2 "  wiki use both      # capture locally, selectively promote reusable knowledge"
          echo >&2 "Then re-capture (pipe the body again or use --body-file ${orphan})."
          exit 1
        else
          # Interactive: prompt user for project | main | both
          # (Implementation: read from /dev/tty, persist via wiki-use.sh,
          # then re-run resolver.)
          echo
          echo "This directory isn't configured for the wiki yet. How should captures here flow?"
          echo "  1) project — create a project wiki at ./wiki/, captures stay local."
          echo "  2) main    — captures go to the main wiki (the default)."
          echo "  3) both    - capture locally, then selectively promote reusable knowledge."
          echo
          read -r -p "Reply with 1, 2, or 3: " choice </dev/tty
          case "${choice}" in
            1) bash "${REPO_ROOT}/scripts/wiki-use.sh" project ;;
            2) bash "${REPO_ROOT}/scripts/wiki-use.sh" main ;;
            3) bash "${REPO_ROOT}/scripts/wiki-use.sh" both ;;
            *) echo >&2 "wiki capture: invalid choice '${choice}'; aborting"; exit 1 ;;
          esac
          resolver_plan="$(bash "${REPO_ROOT}/scripts/wiki-resolve.sh" --plan 2>/dev/null)" \
            && resolver_exit=0
        fi
        ;;
      13|14)
        # Malformed authoritative runtime or broken configured target.
        case "${resolver_exit}" in
          13) reason="resolver exit 13: malformed workspace routing configuration" ;;
          14) reason="resolver exit 14: configured wiki target is incomplete" ;;
        esac
        orphan="$(bash "${REPO_ROOT}/scripts/wiki-orphan.sh" \
          --title "${title}" \
          --reason "${reason}" \
          --body-file "${body_buf}")"
        echo >&2 "wiki capture: aborted; ${reason}; body preserved at ${orphan}"
        exit 1
        ;;
      *)
        echo >&2 "wiki capture: resolver returned unexpected exit ${resolver_exit}"
        exit 1
        ;;
    esac

    if [[ -z "${resolver_plan}" ]]; then
      echo >&2 "wiki capture: resolver returned no plan despite exit 0"
      exit 1
    fi
    resolver_out="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["primary_wiki"])' <<< "${resolver_plan}")"
    promotion_policy="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["promotion_policy"])' <<< "${resolver_plan}")"
    if [[ -z "${resolver_out}" || ( "${promotion_policy}" != "none" && "${promotion_policy}" != "selective" ) ]]; then
      echo >&2 "wiki capture: resolver returned an invalid plan"
      exit 1
    fi

    # Build one initial capture. In both mode the project ingester decides
    # whether reusable knowledge is later promoted to the pinned main wiki.
    ts="$(date -u +%Y-%m-%dT%H-%M-%SZ)"
    slug="$(slugify "${title}")"
    capture_id="cap-$(python3 -c 'import uuid; print(uuid.uuid4().hex)')"
    target_count=0
    while IFS= read -r target_wiki; do
      [[ -n "${target_wiki}" ]] || continue
      target_count=$((target_count + 1))
      capture_path="${target_wiki}/.wiki-pending/${ts}-${slug}.md"

      # Resolve evidence_type from kind. Iron rule: `evidence` is the
      # canonical source path (or the literal "conversation" only when
      # kind=chat-only with no attached file).
      case "${kind}" in
        chat-only)     evidence_type="conversation"; evidence="conversation" ;;
        chat-attached) evidence_type="mixed"; evidence="${evidence_path}" ;;
        raw-direct)    evidence_type="file"; evidence="${evidence_path}" ;;
      esac

      capture_temp="$(mktemp "${target_wiki}/.wiki-pending/.capture.XXXXXX")"
      {
        echo "---"
        printf 'title: %s\n' "$(yaml_quote "${title}")"
        printf 'evidence: %s\n' "$(yaml_quote "${evidence}")"
        echo "evidence_type: \"${evidence_type}\""
        echo "capture_kind: \"${kind}\""
        printf 'suggested_action: %s\n' "$(yaml_quote "${suggested_action}")"
        echo "suggested_pages: []"
        echo "captured_at: \"${ts}\""
        echo "captured_by: \"in-session-agent\""
        echo "capture_id: \"${capture_id}\""
        echo "promotion_policy: \"${promotion_policy}\""
        echo "promotion_decision: null"
        echo "promotion_id: null"
        echo "propagated_from: null"
        echo "---"
        echo
        cat "${body_buf}"
      } > "${capture_temp}"
      chmod 0644 "${capture_temp}"

      # Publish a complete inode atomically. If the same title is captured
      # twice within one second, preserve both instead of overwriting either.
      capture_candidate="${capture_path}"
      capture_suffix=1
      while true; do
        if ln "${capture_temp}" "${capture_candidate}" 2>/dev/null; then
          break
        fi
        if [[ -e "${capture_candidate}" ]]; then
          capture_candidate="${capture_path%.md}-${capture_suffix}.md"
          capture_suffix=$((capture_suffix + 1))
          continue
        fi
        rm -f "${capture_temp}"
        echo >&2 "wiki capture: could not publish capture in ${target_wiki}/.wiki-pending"
        exit 1
      done
      rm -f "${capture_temp}"

    done <<< "${resolver_out}"

    # A missing or legacy local runtime config must never lose the capture.
    # The user gets one actionable warning and can drain it after configuring
    # the wiki; capture itself remains a successful durable operation.
    while IFS= read -r target_wiki; do
      [[ -n "${target_wiki}" ]] || continue
      if ! dispatch_error="$(python3 "${REPO_ROOT}/scripts/wiki_dispatch.py" tick \
          --wiki "${target_wiki}" --source capture 2>&1)"; then
        echo >&2 "wiki capture: saved, but dispatcher did not start for ${target_wiki}:"
        echo >&2 "${dispatch_error}"
      fi
    done <<< "${resolver_out}"

    echo "wiki capture: ${target_count} target(s) - ${title}"
    ;;
  init-main)
    bash "${REPO_ROOT}/scripts/wiki-init-main.sh" "$@"
    ;;
  use)
    bash "${REPO_ROOT}/scripts/wiki-use.sh" "$@"
    ;;
  config)
    config_action="${1:-}"
    [[ -n "${config_action}" ]] || {
      echo >&2 "usage: wiki config init-local|migrate|migrate-local|validate|show|path|update-runtime <wiki-path> [options]"
      exit 1
    }
    shift
    case "${config_action}" in
      init-local|migrate|migrate-local|validate|show|path|update-runtime)
        config_wiki="${1:-}"
        [[ -n "${config_wiki}" ]] || {
          echo >&2 "wiki config ${config_action}: <wiki-path> required"
          exit 1
        }
        shift
        python3 "${REPO_ROOT}/scripts/wiki_config.py" "${config_action}" --wiki "${config_wiki}" "$@"
        ;;
      *)
        echo >&2 "wiki config: unknown action '${config_action}'; valid: init-local|migrate|migrate-local|validate|show|path|update-runtime"
        exit 1
        ;;
    esac
    ;;
  scheduler)
    scheduler_action="${1:-}"
    case "${scheduler_action}" in
      install|uninstall|status) ;;
      *)
        echo >&2 "usage: wiki scheduler install|uninstall|status <wiki-path> [--json]"
        exit 1
        ;;
    esac
    shift
    scheduler_wiki="${1:-}"
    [[ -n "${scheduler_wiki}" ]] || {
      echo >&2 "wiki scheduler ${scheduler_action}: <wiki-path> required"
      exit 1
    }
    shift
    python3 "${REPO_ROOT}/scripts/wiki_scheduler.py" "${scheduler_action}" \
      --wiki "${scheduler_wiki}" "$@"
    ;;
  tick)
    tick_wiki=""
    if [[ $# -gt 0 && "$1" != --* ]]; then
      tick_wiki="$1"
      shift
    else
      tick_wiki="$(wiki_root)"
    fi
    python3 "${REPO_ROOT}/scripts/wiki_dispatch.py" tick --wiki "${tick_wiki}" "$@"
    ;;
  ingest-now)
    if [[ -f "${REPO_ROOT}/scripts/wiki-ingest-now.sh" ]]; then
      bash "${REPO_ROOT}/scripts/wiki-ingest-now.sh" "$@"
    else
      echo >&2 "wiki ingest-now: not implemented (Leg 3 ships this)."
      exit 1
    fi
    ;;
  issues)
    bash "${REPO_ROOT}/scripts/wiki-issues.sh" --wiki "$(wiki_root)" "$@"
    ;;
  help|--help|-h)
    cat <<EOF
usage: wiki <subcommand>

subcommands:
  capture        Write a chat-driven capture (the agent's canonical entry point)
                   wiki capture --title T --kind chat-only|chat-attached --suggested-action <act> [--body-file <path>]
                   Body via stdin (pipe) OR --body-file. Max 256 KB.
  ingest-now     Scan sources and run one bounded drain on demand
                   wiki ingest-now [<wiki-path>]
  issues         Show ingester-reported issues (grouped, severity-ordered)
                   wiki issues
  use            Change per-cwd wiki mode
                   wiki use project|main|both
  config         Manage per-user runtime configuration
                   wiki config init-local|migrate|validate|show|update-runtime <wiki-path> [options]
  scheduler      Manage the macOS cron-like LaunchAgent adapter
                   wiki scheduler install|uninstall|status <wiki-path>
  tick           Run one bounded queue-dispatch pass
                   wiki tick [<wiki-path>] --source session_start|scheduled|manual|capture|worker_completion [--scan]
  init-main      Bootstrap ~/.wiki-pointer (interactive)
  status         Read-only health report
  doctor         Deep lint + fix (post-MVP)
  help           This message
EOF
    ;;
  *)
    echo >&2 "unknown subcommand: ${sub}"
    echo >&2 "try: wiki help"
    exit 1
    ;;
esac
